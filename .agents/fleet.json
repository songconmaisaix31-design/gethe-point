{
  "schema_version": 1,
  "project": "gethe-point",
  "repo_selector": "path:C:/Users/DW/orca/projects/gethe-point",
  "base_ref": "origin/songconmaisaix31-design/we-remember-requested-fleet-v2",
  "fetch_before_launch": true,
  "coordinator": {
    "agent": "codex",
    "setup": "run",
    "worktree_prefix": "fleet-control"
  },
  "worker_defaults": {
    "agent": "codex",
    "setup": "run",
    "worktree_mode": "new-top-level"
  },
  "branch_rules": {
    "track_pattern": "^(?:[^/]+/)?trk-(?P<track>[a-z0-9_]+)-(?P<task>[a-z0-9-]+)$",
    "control_pattern": "^(?:[^/]+/)?fleet-control(?:-|$)",
    "base_branches": [
      "main",
      "master",
      "develop"
    ]
  },
  "global_forbidden": [
    ".git/**",
    ".env",
    ".env.local",
    ".env.production",
    "**/.env",
    "**/.env.local",
    "**/.env.production",
    ".npmrc",
    "**/.npmrc",
    ".pypirc",
    "**/.pypirc",
    "*.pem",
    "*.key",
    "*.p12",
    "*.pfx",
    "**/*.pem",
    "**/*.key",
    "**/*.p12",
    "**/*.pfx",
    "**/*credential*"
  ],
  "tracks": {
    "control": {
      "description": "Coordinator plans, run state, decisions, and cross-track handoffs; no product code",
      "allow": [
        ".agents/plans/**",
        ".agents/runs/**",
        ".agents/decisions/**",
        ".agents/handoffs/**"
      ],
      "checks": []
    },
    "product": {
      "description": "Product requirements, acceptance, and user-facing scope",
      "allow": [
        "产品需求文档_都记得_PRD.md",
        "docs/product/**"
      ],
      "checks": []
    },
    "foundation": {
      "description": "Root workspace, locked dependencies, shared build configuration, and local developer harness",
      "allow": [
        ".gitignore",
        "package.json",
        "pnpm-workspace.yaml",
        "pnpm-lock.yaml",
        "tsconfig.json",
        "tsconfig.base.json",
        "eslint.config.*",
        "vitest.config.*",
        "packages/config/**",
        "tools/**"
      ],
      "checks": []
    },
    "architecture": {
      "description": "Shared API contracts, schemas, state machines, security boundaries, and UI tokens",
      "allow": [
        "packages/contracts/**",
        "docs/architecture/**",
        "Tech-Spec.md",
        "API_CONTRACT.md",
        "FLEET_DEPLOYMENT_SPEC.md"
      ],
      "checks": []
    },
    "data": {
      "description": "PostgreSQL schema, migrations, repositories, and disposable database verification",
      "allow": [
        "packages/db/**"
      ],
      "checks": []
    },
    "experience": {
      "description": "Role-specific responsive web experience built against fixed contract fixtures first",
      "allow": [
        "apps/web/next.config.*",
        "apps/web/tsconfig.json",
        "apps/web/public/**",
        "apps/web/src/app/(ui)/**",
        "apps/web/src/app/globals.css",
        "apps/web/src/app/layout.tsx",
        "apps/web/src/app/page.tsx",
        "apps/web/src/components/**",
        "apps/web/src/features/**",
        "apps/web/tests/**"
      ],
      "checks": []
    },
    "conversation": {
      "description": "Private conversation, consented signal drafting, AI witness, and high-risk boundary handling",
      "allow": [
        "modules/conversation/**",
        "modules/ai-witness/**",
        "modules/boundary/**"
      ],
      "checks": []
    },
    "responsibility": {
      "description": "Five-stage ownership, responsibility domains, and deterministic neutral reports",
      "allow": [
        "modules/responsibility/**",
        "modules/ai-domain/**"
      ],
      "checks": []
    },
    "handover": {
      "description": "Blocked-by-default two-party handover and atomic owner/reminder migration",
      "allow": [
        "modules/handover/**",
        "modules/ai-handover/**"
      ],
      "checks": []
    },
    "care": {
      "description": "Human-confirmed deterministic care rules, scheduling, acknowledgement, and escalation",
      "allow": [
        "modules/care/**"
      ],
      "checks": []
    },
    "privacy": {
      "description": "Evidence access, consent revocation, export, deletion, and authorization policy",
      "allow": [
        "modules/privacy/**"
      ],
      "checks": []
    },
    "qa": {
      "description": "Fictional golden fixtures, contract acceptance, browser E2E, accessibility, and visual evidence",
      "allow": [
        "packages/testkit/**",
        "fixtures/**",
        "tests/e2e/**",
        "playwright.config.*"
      ],
      "checks": []
    },
    "integration": {
      "description": "Sole integrator for exact-SHA assembly, application adapters, release evidence, and deployment",
      "allow": [
        "apps/web/src/app/api/**",
        "apps/web/src/auth/**",
        "apps/web/src/integration/**",
        "apps/web/src/server/**",
        "apps/web/middleware.ts",
        "docs/demo/**",
        "docs/release/**",
        "deploy/**",
        "README.md",
        "vercel.json"
      ],
      "checks": []
    },
    "automation": {
      "description": "Fleet control plane, machine gates, prompts, governance, and CI",
      "allow": [
        "scripts/**",
        ".githooks/**",
        ".github/**",
        ".agents/fleet.json",
        ".agents/.gitignore",
        ".agents/prompts/**",
        "AGENTS.md",
        "MEMORY.md",
        "PRINCIPLES.md",
        "TEST_REPORT.md",
        "Makefile",
        "orca.yaml"
      ],
      "checks": [
        "python -B -m unittest discover -s scripts/tests -v"
      ]
    }
  }
}
